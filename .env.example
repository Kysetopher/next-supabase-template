# Copy to .env.local and fill in your Supabase project's values.
# Not NEXT_PUBLIC_-prefixed on purpose — there's no browser Supabase client
# in this app, everything runs server-side. See docs/AUTH.md.

# Dashboard > Settings > API Keys > "Publishable and secret API keys" tab.
# The publishable key replaces the legacy anon key (same role: safe anywhere,
# Postgres RLS is what actually enforces access).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Same tab, "Secret key". Bypasses RLS entirely. Only ever read from
# src/lib/supabase/service.ts — see docs/AUTH.md before importing it.
SUPABASE_SECRET_KEY=

# Origin the app is served from, no trailing slash (http://localhost:3000 in
# dev). Used for auth email redirect links and metadataBase. Add
# <SITE_URL>/auth/callback, <SITE_URL>/auth/email-change and
# <SITE_URL>/auth/recovery to Supabase > Authentication > URL Configuration >
# Redirect URLs.
SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Stripe (optional)
# Billing is OFF unless all three are set — leave them all empty to run
# without it. Setting only some stops the server at startup. Use test-mode
# keys (sk_test_/pk_test_) in development; the two keys must be the same
# mode. See docs/STRIPE.md.
#
# Stripe Dashboard > Developers > API keys. The secret key (or a restricted
# rk_ key) is server-only; the publishable key is handed to the checkout form
# at request time — neither is NEXT_PUBLIC_.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Signing secret for POST /api/webhooks/stripe. In production: Dashboard >
# Developers > Webhooks > your endpoint > "Signing secret". Locally, run
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# and paste the whsec_... it prints (it changes per `stripe login`).
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# One Price id per product in src/lib/billing/products.ts, in the env var
# that product names (Dashboard > Product catalog > the product > price_...).
# STRIPE_PRICE_PRO=price_...
