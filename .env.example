# Copy to .env.local and fill in your Supabase project's values.
# Not NEXT_PUBLIC_-prefixed on purpose — there's no browser Supabase client
# in this app, everything runs server-side. See docs/AUTH.md.

# Dashboard > Settings > API Keys > "Publishable and secret API keys" tab.
# The publishable key replaces the legacy anon key (same role: safe anywhere,
# Postgres RLS is what actually enforces access).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Same tab, "Secret key". Bypasses RLS entirely. Only ever read from
# src/lib/supabase/service.ts — see docs/AUTH.md before importing it.
SUPABASE_SECRET_KEY=

# Origin the app is served from, no trailing slash (http://localhost:3000 in
# dev). Used for auth email redirect links and metadataBase. Add
# <SITE_URL>/auth/callback and <SITE_URL>/auth/email-change to Supabase >
# Authentication > URL Configuration > Redirect URLs.
SITE_URL=http://localhost:3000
